# Modelo das variáveis de ambiente da API.
# Copie para .env (cp .env.example .env). O .env NÃO vai para o Git.

# Porta da API. O frontend espera a API em http://localhost:3001/api
PORT=3001
NODE_ENV=development

# Endereço do frontend (Vite) liberado no CORS
FRONTEND_URL=http://localhost:5173

# Reservadas para o MVP (banco de dados e autenticação). Ficam vazias na Semana 1.
DATABASE_URL=
API_SECRET=

# Provedores de IA (Sprint 2). Preencha a chave de pelo menos um para usar a IA de verdade.
# Sem nenhuma chave, a API funciona em "modo demonstração" (análise por regras, mesmo formato).
# As chaves ficam só aqui na API, nunca no frontend.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
# Chave do Google AI Studio (https://aistudio.google.com/apikey), tem cota gratuita
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Revisão ortográfica (LanguageTool). Vazio = API pública gratuita.
LANGUAGETOOL_URL=
