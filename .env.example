# Modelo das variáveis de ambiente da API.
# Copie para .env (cp .env.example .env). O .env NÃO vai para o Git.

# Porta da API. O frontend espera a API em http://localhost:3001/api
PORT=3001
NODE_ENV=development

# Endereço do frontend (Vite) liberado no CORS
FRONTEND_URL=http://localhost:5173

# Reservadas para o MVP (banco de dados e autenticação). Ficam vazias na Semana 1.
DATABASE_URL=
API_SECRET=
